# Flightdeck Environment Configuration

# --- Data Source Toggle ---
# Set to "false" to use live APIs (Travelpayouts & Ryanair)
# Set to "true" to use offline demo/mock data
DEMO_MOCK=false
NEXT_PUBLIC_DEMO_MOCK=false

# --- Live Flight API (Travelpayouts / Aviasales) ---
# Sign up at https://www.travelpayouts.com/ to get your token and marker:
# 1. TRAVELPAYOUTS_TOKEN: Required for live global prices (Aviasales Data API)
# 2. TRAVELPAYOUTS_MARKER: Optional partner ID for affiliate booking redirect links
TRAVELPAYOUTS_TOKEN=your_token_here
TRAVELPAYOUTS_MARKER=your_marker_here

# --- Ground Transit Providers (Optional) ---
ENABLE_FLIXBUS=false
